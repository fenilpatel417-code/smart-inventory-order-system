PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection (Local or Atlas)
MONGODB_URI=mongodb://localhost:27017/smart_inventory

# JWT Secret Keys
JWT_ACCESS_SECRET=super_secret_access_token_key_change_in_production_123456
JWT_REFRESH_SECRET=super_secret_refresh_token_key_change_in_production_654321
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email (SMTP / Ethereal / Gmail)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Smart Inventory <no-reply@smartinventory.com>"

# Scheduled Cron
ENABLE_CRON=true
CRON_SCHEDULE="0 8 * * *" # Daily at 8:00 AM
